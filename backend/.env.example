# Copy to .env locally.
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://jobdiscover:local-development-only@127.0.0.1:54329/jobdiscover
DATABASE_SSL=false
SESSION_DAYS=30
AUTH_EMAIL_MODE=console
# En production, utiliser AUTH_EMAIL_MODE=smtp et renseigner les 5 variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AI_PUBLIC_JOB_ENRICHMENT=false
CRON_SECRET=
