# Copy to .env.local locally; configure secrets in the hosting dashboard.
APP_ORIGIN=http://localhost:3000
BACKEND_URL=http://127.0.0.1:3100
BACKEND_SHARED_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://jobdiscover:local-development-only@127.0.0.1:54329/jobdiscover
DATABASE_SSL=false
RESEND_API_KEY=
EMAIL_FROM=JobDiscover <comptes@example.fr>
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
CRON_SECRET=

# Enable only after reviewing provider processing terms for public job descriptions.
AI_PUBLIC_JOB_ENRICHMENT=false
